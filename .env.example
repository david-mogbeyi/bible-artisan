# Copy to .env at the repo root. Loaded by apps/api (API + worker).
# Required (no default): development | test | production. The API refuses to start without it, so
# a deploy can't silently fall back to development behaviour. Deploys must set production.
NODE_ENV=development
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API with credentials. It also gates
# every mutation (CSRF): other origins get 403. Each entry is an exact bare origin
# (scheme://host[:port], no path, trailing slash, or wildcard). Read by the HTTP API only: the API
# refuses to start in production without it, and every entry must be https there. The worker
# has no HTTP surface and ignores it.
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://localhost:5432/bible_artisan_dev
# Used only by integration tests; it is migrated and truncated freely.
DATABASE_URL_TEST=postgres://localhost:5432/bible_artisan_test
LOG_LEVEL=debug

# Email OTP sign-in (BIB-10). `dev` keeps codes in memory (never logged) and is refused when
# NODE_ENV=production (and it is the default, so a production deploy must set `stytch`);
# `stytch` uses Stytch Email OTP and needs both credentials (never commit them).
OTP_PROVIDER=dev
# Dev provider only: the latest code is written here so you can sign in locally (gitignored).
DEV_OTP_OUTBOX_FILE=.dev/otp-outbox.json
# STYTCH_API_URL=https://test.stytch.com   # https://api.stytch.com for live projects
# STYTCH_PROJECT_ID=
# STYTCH_SECRET=
# Session cookie Secure flag. Keep true; set false only for a local browser that rejects
# Secure cookies on http://localhost. Refused in production.
SESSION_COOKIE_SECURE=true

# Library cursors (BIB-21) are encrypted with AES-256-GCM under a key derived from this secret:
# 32 random bytes, base64 (`openssl rand -base64 32`). Required in production (the HTTP API
# refuses to start without it); elsewhere a fixed development secret is used when unset.
# Rotating it only makes outstanding "Load more" cursors fail with 400 (the list restarts).
# CURSOR_SECRET=
