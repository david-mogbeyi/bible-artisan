{
  "name": "@bible-artisan/api",
  "version": "0.0.0",
  "private": true,
  "description": "NestJS modular monolith: REST API (/v1) and background worker from one codebase.",
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest --project unit",
    "db:migrate": "tsx src/database/migrate.ts latest",
    "db:migrate:down": "tsx src/database/migrate.ts down",
    "db:migrate:make": "tsx src/database/migrate.ts make",
    "corpus:import": "tsx src/modules/bible-content/corpus/import-corpus.ts"
  },
  "dependencies": {
    "@bible-artisan/contracts": "workspace:*",
    "@nestjs/core": "12.1.2",
    "@nestjs/common": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sequelize": "6.37.8",
    "sequelize-typescript": "2.1.6",
    "umzug": "3.8.3",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "12.1.2",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.6",
    "@types/pg": "8.23.1",
    "@types/validator": "13.15.10",
    "tsx": "4.23.15",
    "@swc/core": "1.16.13",
    "@swc/cli": "0.8.1",
    "unplugin-swc": "2.0.0",
    "supertest": "7.3.0",
    "@types/supertest": "7.2.1"
  }
}
