# Copy to .env at the repo root. Loaded by apps/api (API + worker).
NODE_ENV=development
API_PORT=4000
# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=postgres://localhost:5432/bible_artisan_dev
# Used only by integration tests; it is migrated and truncated freely.
DATABASE_URL_TEST=postgres://localhost:5432/bible_artisan_test
LOG_LEVEL=debug

# Email OTP sign-in (BIB-10). `dev` keeps codes in memory (never logged) and is refused in
# production; `stytch` uses Stytch Email OTP and needs both credentials (never commit them).
OTP_PROVIDER=dev
# Dev provider only: the latest code is written here so you can sign in locally (gitignored).
DEV_OTP_OUTBOX_FILE=.dev/otp-outbox.json
# STYTCH_API_URL=https://test.stytch.com   # https://api.stytch.com for live projects
# STYTCH_PROJECT_ID=
# STYTCH_SECRET=
# Session cookie Secure flag. Keep true; set false only for a local browser that rejects
# Secure cookies on http://localhost. Refused in production.
SESSION_COOKIE_SECURE=true
