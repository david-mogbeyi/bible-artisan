{
  "name": "@bible-artisan/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared REST DTO schemas (Zod) and types for the API and web client. No database models.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
